# dogspeak — local dev environment
# Loaded by `make dev` / `make run` (see makefile). NOT committed — see .gitignore.

# The Vite dev server proxies /api and /ws here (client/vite.config.ts).
# In prod, PORT is injected by the host (Render).
PORT=8080

# Auth — the server exits on startup without these two.
ROOM_PASSWORD=XXXXXXXX
SESSION_SECRET=XXXXXXXX

# Cookies — dev runs over http://localhost, so leave the domain blank and
# Secure off (a Secure cookie won't set over plain http). In prod (HTTPS) set
# COOKIE_SECURE=true, or ENV=production, which also turns it on.
COOKIE_DOMAIN=
COOKIE_SECURE=false
# ENV=production

# Maintenance mode: true/1 parks every client on the maintenance screen
# (/ws + /api/session answer 503; /api/status, /api/health and the SPA stay up).
MAINTENANCE=false

# Logging — LOG_LEVEL: debug|info|warn|error, LOG_FORMAT: text|json (json in prod)
LOG_LEVEL=info
LOG_FORMAT=text
